NODE_ENV=development # || production

PORT=3000

# Puerto del HOST para la app containerizada (perfil `full` del compose).
APP_PORT=3000

# Database
# Estas mismas variables las lee docker-compose.yml para levantar Postgres.
# DB_HOST/DB_PORT son como llega la app DESDE EL HOST. Cuando la app corre
# dentro de compose, el propio compose los pisa por 'postgres' y 5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notifications_db

# JWT Passport
# En produccion: algo largo y random (ej: openssl rand -hex 32)
# En producción: obligatorio, >= 32 caracteres (openssl rand -hex 32). Ver ADR-015.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Vigencia del token de reseteo de contraseña (minutos)
RESET_TOKEN_EXPIRES_MINUTES=15
